<!-- Custom header -->
<div class="custom-background-color-blue">
  <header class="header container">
    <div class="custom-header-container">
      <a href="https://www.configura.com" class="custom-logo logo" target="_blank">
        <img src="{{settings.logo}}" alt="{{t 'home_page' name=help_center.name}}">
      </a>
      {{dc 'to_home_page'}}

    </div>
<div class="custom-nav-wrapper nav-wrapper">

  <!-- User Navigation-->
  <button
    class="menu-button-mobile icon-menu"
    type="button"
    aria-controls="user-nav"
    aria-expanded="false"
    aria-label="{{t 'toggle_navigation'}}"
  ></button>

  <a
    href="https://app.configura.com/"
    class="custom-myconfigura-link material-icons-big"
    title="Back to MyConfigura"
    target="_blank"
    rel="noopener noreferrer"
  >
    <i class="material-icons material-icons-margin-right">keyboard_backspace</i>
    {{dc 'back_to_myconfigura'}}
  </a>

  <a
    href="https://configura.zendesk.com/hc/{{help_center.locale}}/categories/1500001668021"
    class="btn custom-download-extensions-btn material-icons-big"
    role="button"
    title="Contact Us"
    target="_blank"
    rel="noopener noreferrer"
  >
    <i class="material-icons material-icons-margin-right blue-icon">layers</i>
    {{dc 'need_help_contact_us'}}
  </a>

  <!-- Burger menu container -->
  <nav class="user-nav custom-display-links" id="user-nav" aria-label="{{t 'user_navigation'}}">
    <a href="/"></a>
  </nav>

  <!-- User info menu-->
{{#if signed_in}}
  <div class="custom-signin-link user-info dropdown" title="User information">
    <button id="user-menu-toggle" class="dropdown-toggle user-menu-toggle" type="button"
      aria-haspopup="true" aria-expanded="false" aria-controls="user-menu">
      {{user_avatar class="user-avatar"}}
      <span class="user-name">{{user_name}}</span>
    </button>

    <div class="dropdown-menu user-menu" id="user-menu" role="menu" hidden>
      {{#my_profile role="menuitem"}}{{t "profile"}}{{/my_profile}}
      {{#link "requests" role="menuitem"}}{{dc 'ticket_portal_menu_option'}}{{/link}}
      {{change_password role="menuitem"}}
      {{#link "sign_out" role="menuitem"}}{{t "sign_out"}}{{/link}}
    </div>
  </div>
{{else}}
  <div class="custom-signin-link">
    {{#link "sign_in"}}{{t "sign_in"}}{{/link}}
  </div>
{{/if}}
  <div class="custom-locale user-info dropdown" title="Language">
  <button
    id="locale-menu-toggle"
    class="dropdown-toggle user-menu-toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="locale-menu"
  >
    <span class="user-name">
      {{#is help_center.locale "en-us"}}English{{/is}}
      {{#is help_center.locale "de"}}Deutsch{{/is}}
      {{#is help_center.locale "ja"}}日本語{{/is}}
      {{#is help_center.locale "zh-cn"}}中文{{/is}}
    </span>
  </button>

  <div class="dropdown-menu user-menu" id="locale-menu" role="menu" hidden>
  <a role="menuitem" href="#" data-locale="en-us">English</a>
  <a role="menuitem" href="#" data-locale="de">Deutsch</a>
  <a role="menuitem" href="#" data-locale="ja">日本語</a>
  <a role="menuitem" href="#" data-locale="zh-cn">中文</a>
</div>
</div>
</div>
      </div>
</header>