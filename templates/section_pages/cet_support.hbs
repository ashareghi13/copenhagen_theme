<div class="container-divider"></div>
<div class="container">
    <nav class="sub-nav custom-page-search-mini">
        {{breadcrumbs}}
        {{search scoped=true submit=false placeholder='Search for help articles, videos and more'}}
    </nav>
    <header class="page-header">
        <span>
            <h1>{{section.name}}</h1>
            <p class="custom-contact-header-additional-desc">
                <b>{{section.description}}</b>
            </p>
            <h2>{{dc 'contact_us'}}</h2>
        </span>
    </header>

    <!-- CONTACT CARDS -->
    <div class="custom-card-container">
    {{#each (slice section.sections 0 8)}} <!-- startIndex = 0, number of elements = 8; -->
        
            {{#is id 1500002293041}} {{!-- User Email --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="mailto:cetsupport@configura.com" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">email</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
      
{{#is id 1500002293841}} {{!-- Chat --}}
  <div class="custom-contact-card-wrapper">
    <section class="custom-card small-card">
      <a href="#"
         class="custom-card-link js-open-messaging"
         aria-label="Start a new chat with support">

        <div class="custom-card-logo-container">
          <i class="material-icons black-icon">textsms</i>
        </div>

        <h3 class="custom-card-title">
          {{name}}
        </h3>
      </a>
    </section>

    <p>{{description}}</p>
  </div>
{{/is}}
      
        {{#is id 1500002293861}} {{!-- Call --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://support.configura.com/hc/{{dc 'locale'}}/articles/360041358813" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">call</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
      
        {{#is id 1500002273242}} {{!-- User Forums --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://www.configura.com/my/forum" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">people</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
      
        {{#is id 1500002293921}} {{!-- User Global Support Availability --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://support.configura.com/hc/p/GlobalSupportAvailability" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">access_time</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
        {{#is id 1500002912642 }} {{!-- Academy --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://academy.configura.com/home" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">school</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
        {{#is id 1500002912602 }} {{!-- CET Experience --}}
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://www.configura.com/events" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">business</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
    {{/each}}
    </div>

     <!-- QUICK LINKS CARDS -->
    <h2 style="display:none;">Quick Links</h2>
    <div class="custom-card-container">
    {{#each (slice section.sections 8 1)}} <!-- startIndex = 8, number of elements = 1; -->
        {{#is id 1500002293961}} {{!-- User FAQs --}}
            <script> $("h2:contains('Quick Links')").css("display", "block"); </script>
            <div class="custom-contact-card-wrapper">
                <section class="custom-card small-card">
                    <a href="https://support.configura.com/hc/{{dc 'locale'}}/sections/360003354354-FAQ" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">help_outline</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                </section>
                <p>{{description}}</p>
            </div>
        {{/is}}
    {{/each}}
    </div>
