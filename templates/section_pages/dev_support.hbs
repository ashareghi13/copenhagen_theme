<div class="container-divider"></div> {{!--This is the page directly connected to Developer Contact Us Page --}}
<div class="container">
    <nav class="sub-nav custom-page-search-mini">
        {{breadcrumbs}}
        {{search scoped=true submit=false placeholder='Search for help articles, videos and more'}}
    </nav>
    <header class="page-header">
        <span>
            <h1>{{section.name}}</h1>
            <p class="custom-contact-header-additional-desc">
                <b>{{section.description}}</b>
            </p>
            <h2>{{dc 'contact_us'}}</h2>
        </span>
    </header>
      <!-- CONTACT CARDS -->
    <div class="custom-card-container">
      {{#each (slice section.sections 0 4)}} <!-- startIndex = 0, number of elements = 4; -->
        <div class="custom-contact-card-wrapper">
            <section class="custom-card small-card">
                {{#is id 1500002506442}} {{!-- Dev Contact Support --}}
                    <a href="https://configura.atlassian.net/servicedesk/customer/portal/3/group/13" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">desktop_windows</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                {{#is id 1500002506482}} {{!-- Dev Community --}}
                    <a href="https://my.configura.com/index.pl?page=forum&section=developer&subsection=devs" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">people</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                {{#is id 1500002611922}} {{!-- Open Office --}}
                    <a href="https://dev-academy.configura.com/course/developer-open-office-hours" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">event</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                {{#is id 22306951663767}} {{!-- Quarterly Chat With Developers --}}
                    <a href="https://support.configura.com/hc/{{dc 'locale'}}/article_attachments/22307040521111" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">3p</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                </section>
            <p>{{description}}</p>
        </div>
    {{/each}}
    </div>

     <!-- QUICK LINKS CARDS -->
    <h2>Quick Links</h2>
    <div class="custom-card-container">
      {{#each (slice section.sections 4 section.sections.length "-" 3)}} <!-- startIndex = 4, number of elements = section.sections.length - 3; -->
        <div class="custom-contact-card-wrapper">
            <section class="custom-card small-card">
                {{#is id 1500002506502}} {{!-- Dev Help Center --}}
                    <a href="https://support.configura.com/hc/{{dc 'locale'}}/categories/360003927054-CET-Developer" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">help_outline</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                {{#is id 1500002506522}} {{!-- Dev Migration Guide --}}
                    <a href="https://migration.configura.com/" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">next_week</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
                {{#is id 1500002534741}} {{!-- Dev Release Timeline --}}
                    <a href="https://release.configura.com" target="_blank" rel="noopener noreferrer" class="custom-card-link">
                        <div class="custom-card-logo-container">
                            <i class="material-icons black-icon">format_list_numbered</i>
                        </div>
                        <h3 class="custom-card-title">
                            {{name}}
                        </h3>
                    </a>
                {{/is}}
        </section>
        <p>{{description}}</p>
    </div>
    {{/each}}
</div>
