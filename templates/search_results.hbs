<div class="container-divider"></div>
<div class="container">
  <nav class="sub-nav custom-page-search-mini">
    {{breadcrumbs}}
    {{search scoped=true submit=false}} 
    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const params = new URLSearchParams(window.location.search);
    const categoryId = params.get("category");
    if (!categoryId) return;

    const firstBreadcrumb = document.querySelector(
      ".custom-page-search-mini > .breadcrumbs > li:nth-child(1)"
    );
    if (!firstBreadcrumb) return;

    const locale = document.documentElement.lang || "en-us";

    fetch(`/api/v2/help_center/${locale}/categories/${categoryId}.json`, {
      credentials: "same-origin"
    })
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return res.json();
      })
      .then((data) => {
        const category = data.category;
        if (!category || !category.name || !category.html_url) return;

        const li = document.createElement("li");
        li.title = category.name;
        li.innerHTML = `<a href="${category.html_url}">${category.name}</a>`;

        firstBreadcrumb.after(li);
      })
      .catch((err) => {
        console.error("[Breadcrumb category lookup failed]", err);
      });
  });
</script>
  </nav>

 <header class="page-header">
  <h1>{{t 'search_results'}}</h1>
  <p class="page-header-description">{{t 'results' query=query count=results_count}}</p>
</header>

<div class="search-results">
  <section class="search-results-column">
    <h3 class="search-results-subheading">
      {{t 'knowledge_base'}}
    </h3>
    {{generative_answers}}
    {{#if results}}
      <ul class="search-results-list">
        {{#each results}}
         {{#is type "article"}}
  <li class="search-result-list-item result-{{type}}">
    <h2 class="search-result-title">
      <a href="{{url}}" class="results-list-item-link">{{title}}</a>

      {{#if vote_sum}}
        <span class="search-result-meta-inline votes">
          👍 {{vote_sum}}
        </span>
      {{/if}}

      {{#if comment_count}}
        <span class="search-result-meta-inline comments">
          💬 {{comment_count}}
        </span>
      {{/if}}
    </h2>

    <article>
      <ul class="meta-group">
        <li>
          <ol class="breadcrumbs search-result-breadcrumbs">
            {{#each path_steps}}
              <li title="{{name}}"><a href="{{url}}">{{name}}</a></li>
            {{/each}}
          </ol>
        </li>
        <li class="meta-data">{{author.name}}</li>
        <li class="meta-data">{{dc 'article_updated_header'}} {{date created_at timeago=true}}</li>
      </ul>

      <div class="search-results-description">{{text}}</div>
    </article>
  </li>
{{/is}}
        {{/each}}
      </ul>
    {{else}}
      <p>
        {{t 'no_results_unified'}}
        {{#link 'help_center'}}
          {{t 'browse_help_center'}}
        {{/link}}
      </p>
    {{/if}}
  </section>

  {{#if help_center.community_enabled}}
    <section class="search-results-column end-user">
      <h3 class="search-results-subheading">
        {{t 'community'}}
      </h3>
      {{#if results}}
        <ul class="search-results-list">
          {{#each results}}
{{#is type "community_post"}}
  <li class="search-result-list-item result-{{type}}">
    <h2 class="search-result-title">
      <a href="{{url}}" class="results-list-item-link">{{title}}</a>

      {{#if vote_sum}}
        <span class="search-result-meta-inline votes">
          👍 {{vote_sum}}
        </span>
      {{/if}}

      {{#if comment_count}}
        <span class="search-result-meta-inline comments">
          💬 {{comment_count}}
        </span>
      {{/if}}
    </h2>

    <article>
      <ul class="meta-group">
        <li>
          <ol class="breadcrumbs search-result-breadcrumbs">
            {{#each path_steps}}
              <li title="{{name}}"><a href="{{url}}">{{name}}</a></li>
            {{/each}}
          </ol>
        </li>
        <li class="meta-data">{{author.name}}</li>
        <li class="meta-data">{{dc 'community_posted_header'}} {{date created_at timeago=true}}</li>
      </ul>

      <div class="search-results-description">{{text}}</div>
    </article>
  </li>
{{/is}}
          {{/each}}
        </ul>
      {{else}}
        <p>
          {{t 'no_results_unified'}}
          {{#link 'help_center'}}
            {{t 'browse_help_center'}}
          {{/link}}
        </p>
      {{/if}}
    </section>
  {{/if}}

  <section class="search-results-sidebar">
    {{#if help_center.community_enabled}}
      <section class="filters-in-section collapsible-sidebar">
        <h3 class="collapsible-sidebar-title sidenav-title">{{t 'filter_by_type'}}</h3>
        <ul>
          {{#each filters}}
            <li>
              <a href="{{url}}" class="sidenav-item" aria-selected="{{selected}}">{{name}} ({{count}})</a>
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}

    {{#if subfilters}}
      <section class="filters-in-section collapsible-sidebar">
        {{#is current_filter.identifier 'knowledge_base'}}
          <h3 class="collapsible-sidebar-title sidenav-title">{{t 'filter_by_category'}}</h3>
        {{/is}}
        {{#is current_filter.identifier 'community'}}
          <h3 class="collapsible-sidebar-title sidenav-title">{{t 'filter_by_topic'}}</h3>
        {{/is}}
        <ul>
          {{#each subfilters}}
            <li>
              <a href="{{url}}" class="sidenav-item" aria-selected="{{selected}}">{{name}} ({{count}})</a>
            </li>
          {{/each}}
        </ul>
      </section>
    {{/if}}
  </section>
</div>

  {{pagination}}
</div>
